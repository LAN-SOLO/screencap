{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screencap",
  "version": "0.1.2",
  "identifier": "com.lan-solo.screencap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "screencap",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMzJDRDlFRkY4MUI0RQpSV1JPRy9qdjJTd0RBdzZCUS93cFgvMkhLQjYyb3VySzN6dm1LN1U1TTVxK0Z3NEl3ZStPaFp6Vwo=",
      "endpoints": [
        "https://github.com/LAN-SOLO/screencap/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Screenshot-Tool mit Ablage: Aufnahme, Editor, Bibliothek",
    "longDescription": "screencap nimmt Ausschnitte, Fenster und ganze Bildschirme auf, öffnet direkt den Anmerkungs-Editor (Pfeile, Formen, Text, Verpixeln, Zuschneiden) und legt alles durchsuchbar in einer Bibliothek ab — mit Tags, Favoriten und Namen. Alles lokal.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
